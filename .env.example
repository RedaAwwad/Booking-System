# ─── Application ───
PORT=3000

# ─── External flight/hotel APIs ───
DUFFEL_API_TOKEN=
FLIGHTAPI_API_KEY=
FLIGHTAPI_API_URL=https://api.flightapi.io/onewaytrip
SCATTER_GATHER_TIMEOUT=10000

# ─── PostgreSQL ───
DATABASE_HOST=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=test
DATABASE_NAME=booking
DATABASE_PORT=5432
DATABASE_LOCAL_PORT=5432
# DATABASE_URL=postgresql://booking:booking@localhost:5432/booking?schema=public
DATABASE_URL=postgresql://postgres:test@localhost:${DATABASE_LOCAL_PORT}/booking?schema=public&connection_limit=50&pool_timeout=20

# ─── Redis (cache) ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
CACHE_TTL=300000

# ─── RabbitMQ ───
RABBITMQ_USER=booking
RABBITMQ_PASSWORD=booking
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_URL=amqp://booking:booking@localhost:5673/

# ─── Email (SMTP) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── SMS (Twilio stub) ───
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=
