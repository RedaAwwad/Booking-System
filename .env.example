# ─── Application ───
PORT=3000

# ─── External flight/hotel APIs ───
DUFFEL_API_TOKEN=
FLIGHTAPI_API_KEY=
FLIGHTAPI_API_URL=https://api.flightapi.io/onewaytrip
SCATTER_GATHER_TIMEOUT=10000

# ─── PostgreSQL ───
# Use "postgres" as host inside Docker (compose overrides DATABASE_URL),
# use "localhost" when running the API on the host with `npm run dev`.
DATABASE_USER=booking
DATABASE_PASSWORD=booking
DATABASE_NAME=booking
DATABASE_LOCAL_PORT=5433
DATABASE_URL=postgresql://booking:booking@localhost:5433/booking?schema=public

# ─── Redis (cache) ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
CACHE_TTL=300000

# ─── RabbitMQ ───
RABBITMQ_USER=booking
RABBITMQ_PASSWORD=booking
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://booking:booking@localhost:5672/

# Outbox routing — consumers and producers read these; never hardcode in source
NOTIFICATIONS_EXCHANGE=booking.notifications
NOTIFICATIONS_ROUTING_KEY=email.notifications
AUDIT_EXCHANGE=audit.exchange
AUDIT_QUEUE=audit.queue
AUDIT_ROUTING_KEY=audit.events

# ─── Email (SMTP) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── SMS (Twilio stub) ───
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# ─── Keycloak IAM (auth profile) ───
# Start with: docker compose --profile auth up -d
# Admin UI available at: http://localhost:8180
#
# URL where Keycloak is reachable from the HOST (browser / Postman)
KEYCLOAK_URL=http://localhost:8180
# URL where Keycloak is reachable from INSIDE Docker (NestJS → KC)
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=booking-realm
KEYCLOAK_CLIENT_ID=booking-api
KC_PORT=8180
# Master admin credentials for Keycloak Admin UI
# These are NOT your booking-system users — they only control the KC admin console
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=Admin1234!
# booking-realm admin user (auto-created via realm-export.json on first KC boot)
# Change this password in realm-export.json before deploying to any shared environment
KC_BOOKING_ADMIN_EMAIL=admin@booking.com
KC_BOOKING_ADMIN_PASSWORD=Admin1234!
# Version must match across Elasticsearch, Logstash, Kibana, and Filebeat images.
ELK_VERSION=8.13.0
# Set to "true" when running inside Docker so Winston emits JSON logs for Filebeat
DOCKER_ENV=true
# How many days Elasticsearch will keep logs before deleting them (Index Lifecycle Management)
LOG_RETENTION_DAYS=30
# How many days to keep infrastructure logs (redis, rabbitmq, postgres, nginx) — shorter than app logs
INFRA_LOG_RETENTION_DAYS=7
