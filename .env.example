# ─── Application ───
PORT=3000

# ─── External flight/hotel APIs ───
DUFFEL_API_TOKEN=
FLIGHTAPI_API_KEY=
FLIGHTAPI_API_URL=https://api.flightapi.io/onewaytrip
SCATTER_GATHER_TIMEOUT=10000

# ─── PostgreSQL ───
# Use "postgres" as host inside Docker (compose overrides DATABASE_URL),
# use "localhost" when running the API on the host with `npm run dev`.
DATABASE_USER=booking
DATABASE_PASSWORD=booking
DATABASE_NAME=booking
DATABASE_LOCAL_PORT=5433
DATABASE_URL=postgresql://booking:booking@localhost:5433/booking?schema=public

# ─── Redis (cache) ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
CACHE_TTL=300000

# ─── RabbitMQ ───
RABBITMQ_USER=booking
RABBITMQ_PASSWORD=booking
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://booking:booking@localhost:5672/

# Outbox routing — consumers and producers read these; never hardcode in source
NOTIFICATIONS_EXCHANGE=booking.notifications
NOTIFICATIONS_ROUTING_KEY=email.notifications
AUDIT_EXCHANGE=audit.exchange
AUDIT_QUEUE=audit.queue
AUDIT_ROUTING_KEY=audit.events

# ─── Email (SMTP) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── SMS (Twilio stub) ───
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# JWT Secrets
JWT_SECRET=b291703a2eeccba9d5b6a57d2f982b257c43ab6380226d030e17532bac3eb4a7
ACCESS_TOKEN_SECRET=c4fbfd003608af8776a4fa19e6b11149bbd25a1d76e63aecf01c904b6b1836a8
REFRESH_TOKEN_SECRET=faa5edc3b933a7be1202ee80fd2e43f2fd89d6b3597c74e156a3c86fc1cca362

# Token Expiry
# ACCESS_TOKEN_EXPIRY=30d
# REFRESH_TOKEN_EXPIRY=90d

ACCESS_TOKEN_EXPIRY=2592000000
REFRESH_TOKEN_EXPIRY=7776000000

# Password Reset
PASSWORD_RESET_TOKEN_EXPIRY=3600000  # 1 hour in milliseconds
PASSWORD_RESET_URL=http://localhost:3000/auth/reset-password  # Frontend URL for reset page

# Verify Email
EMAIL_VERIFICATION_URL=http://localhost:3000/auth/verify-email  # Frontend URL for email verification
EMAIL_VERIFICATION_TOKEN_EXPIRY=86400000  # 24 hours in milliseconds

# Security
SALT_ROUNDS=10

# ─── Observability ───
LOGSTASH_HOST=localhost
LOGSTASH_PORT=5000
ZIPKIN_URL=http://localhost:9411/api/v2/spans
KIBANA_PORT=5601
ELASTICSEARCH_PORT=9200
ZIPKIN_PORT=9411