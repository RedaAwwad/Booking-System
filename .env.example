# ─── Application ───
PORT=3000

# ─── External flight/hotel APIs ───
DUFFEL_API_TOKEN=
FLIGHTAPI_API_KEY=
FLIGHTAPI_API_URL=https://api.flightapi.io/onewaytrip
SCATTER_GATHER_TIMEOUT=45000

# ─── PostgreSQL ───
# Use "postgres" as host inside Docker (compose overrides DATABASE_URL),
# use "localhost" when running the API on the host with `npm run dev`.
DATABASE_USER=booking
DATABASE_PASSWORD=booking
DATABASE_NAME=booking
DATABASE_LOCAL_PORT=5433
DATABASE_URL=postgresql://booking:booking@localhost:5433/booking?schema=public

# ─── Redis (cache) ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
CACHE_TTL=300000

# ─── RabbitMQ ───
RABBITMQ_USER=booking
RABBITMQ_PASSWORD=booking
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://booking:booking@localhost:5672/

# ─── Email (SMTP) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── SMS (Twilio stub) ───
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=
