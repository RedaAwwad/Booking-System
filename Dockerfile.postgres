FROM postgres:18.4

# Install build tools natively available in Debian
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    postgresql-server-dev-18 \
    git \
    ca-certificates \
    gettext \
    && rm -rf /var/lib/apt/lists/*

# Install pg_cron pinned to the latest release tag.
# --depth 1 downloads only that tag's snapshot, not the full git history.
# The sed step is a Debian/glibc linker workaround: intl symbols are part of
# libc on this platform so the -lintl flag produces a "cannot find" link error.
RUN git clone --branch v1.6.7 --depth 1 https://github.com/citusdata/pg_cron.git \
    && cd pg_cron \
    && grep -rl -- '-lintl' . | xargs -r sed -i 's/-lintl//g' \
    && make \
    && make install \
    && cd .. && rm -rf pg_cron

# Copy initialization scripts (run alphabetically on first postgres startup)
COPY ./init-pgcron.sql /docker-entrypoint-initdb.d/01-init-pgcron.sql
COPY ./init-keycloak-db.sql /docker-entrypoint-initdb.d/02-init-keycloak-db.sql